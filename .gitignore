# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Test Runner leftovers. The performance package writes these into Assets/Resources,
# and anything under a Resources folder is packed into the player — so a shipped
# build would carry the test harness's scratch files.
/[Aa]ssets/Resources/PerformanceTestRun*
/[Aa]ssets/Resources.meta

# Builds
[Bb]uild/
[Bb]uilds/
*.apk
*.aab
*.ipa
*.app

# IDE / editor files
.vscode/
.idea/
.vs/
*.csproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity / platform generated files
ExportedObj/
.gradle/
.consulo/
sysinfo.txt
crashlytics-build.properties
*.unitypackage

# Signing / local credentials
*.keystore
*.jks
*.p12
*.pfx
*.mobileprovision
.env
.env.*
local.properties
GoogleService-Info.plist
google-services.json

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Unity Test Runner temporary scenes
/[Aa]ssets/InitTestScene*.unity
/[Aa]ssets/InitTestScene*.unity.meta

# Mono crash dumps. Unity drops a 10 MB blob in the project root whenever the
# editor is killed rather than closed, which happens routinely in headless runs.
mono_crash.*

# Windows/Unity diagnostics and test results
*.dmp
*.stackdump
/[Tt]est[Rr]esults/
/[Qq][Aa][Oo]utput/
